DB_URL=jdbc:postgresql://localhost:5432/campus_marketplace
DB_USERNAME=postgres
DB_PASSWORD=postgres

JWT_SECRET=<run: openssl rand -base64 32, paste output here>
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

ALLOWED_EMAIL_DOMAIN=seu.edu.bd

MAIL_HOST=mail.footballthreadstore.com
MAIL_PORT=465
MAIL_USERNAME=otp@footballthreadstore.com
MAIL_PASSWORD=<the mailbox password you set in cPanel>
MAIL_SMTP_AUTH=true
# Port 465 = SSL, not STARTTLS
MAIL_SMTP_STARTTLS=false
MAIL_SMTP_STARTTLS_REQUIRED=false
MAIL_SMTP_SSL=true
MAIL_SMTP_CONNECTION_TIMEOUT=10000
MAIL_SMTP_TIMEOUT=10000
MAIL_SMTP_WRITE_TIMEOUT=10000
MAIL_FROM=otp@footballthreadstore.com

OTP_EXPIRATION=10m

# Cloudinary (Settings > API Keys in the Cloudinary console)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=campus-marketplace/listings
UPLOAD_MAX_FILE_SIZE=5MB
UPLOAD_MAX_REQUEST_SIZE=6MB

# Stripe (Developers > API keys). Use a sk_test_ key for development.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint (Developers > Webhooks, or printed by `stripe listen`)
STRIPE_WEBHOOK_SECRET=
PAYMENT_CURRENCY=usd
# Smallest currency unit (cents for usd)
PAYMENT_FEATURE_LISTING_AMOUNT=199
PAYMENT_RESERVE_ITEM_AMOUNT=500
PAYMENT_SUCCESS_URL=http://localhost:3000/payments/success?session_id={CHECKOUT_SESSION_ID}
PAYMENT_CANCEL_URL=http://localhost:3000/payments/cancel
PAYMENT_FEATURE_DURATION=7d
